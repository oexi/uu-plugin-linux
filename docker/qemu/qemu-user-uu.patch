+/*
+ * uu-plugin: the guest (aarch64) and the host (x86_64/aarch64) are both
+ * little-endian LP64 Linux with the asm-generic socket option numbers, so
+ * options QEMU does not know (SO_MARK, SO_ORIGINAL_DST, IP_MTU, TCP_INFO ...)
+ * can be passed to the host unchanged instead of failing.
+ */
+static abi_long passthrough_setsockopt(int sockfd, int level, int optname,
+                                       abi_ulong optval_addr, socklen_t optlen)
+{
+    void *p = NULL;
+    abi_long ret;
+
+    if (optlen > 0) {
+        p = lock_user(VERIFY_READ, optval_addr, optlen, 1);
+        if (!p) {
+            return -TARGET_EFAULT;
+        }
+    }
+    ret = get_errno(setsockopt(sockfd, level, optname, p, optlen));
+    unlock_user(p, optval_addr, 0);
+    return ret;
+}
+
+static abi_long passthrough_getsockopt(int sockfd, int level, int optname,
+                                       abi_ulong optval_addr, abi_ulong optlen)
+{
+    void *p = NULL;
+    socklen_t lv;
+    int len;
+    abi_long ret;
+
+    if (get_user_u32(len, optlen)) {
+        return -TARGET_EFAULT;
+    }
+    if (len < 0) {
+        return -TARGET_EINVAL;
+    }
+    if (len > 0) {
+        p = lock_user(VERIFY_WRITE, optval_addr, len, 0);
+        if (!p) {
+            return -TARGET_EFAULT;
+        }
+    }
+    lv = len;
+    ret = get_errno(getsockopt(sockfd, level, optname, p, &lv));
+    unlock_user(p, optval_addr, ret < 0 ? 0 : MIN(lv, (socklen_t)len));
+    if (ret >= 0 && put_user_u32(lv, optlen)) {
+        return -TARGET_EFAULT;
+    }
+    return ret;
+}
+
