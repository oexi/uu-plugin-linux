+/*
+ * uu-plugin: a guest program that execs another guest binary (uuplugin
+ * starts xuplugin-guardian) would need binfmt_misc on the host.  Instead,
+ * re-exec this QEMU binary with the target program, like binfmt_misc with
+ * the P flag: "qemu -0 argv[0] path argv[1...]".
+ */
+static bool is_guest_elf(const char *path)
+{
+    unsigned char h[EI_NIDENT + 4];
+    uint16_t machine;
+    bool ret = false;
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+
+    if (fd < 0) {
+        return false;
+    }
+    if (read(fd, h, sizeof(h)) == sizeof(h) &&
+        memcmp(h, ELFMAG, SELFMAG) == 0 && h[EI_CLASS] == ELF_CLASS &&
+        h[EI_DATA] == ELFDATA2LSB) {
+        machine = h[EI_NIDENT + 2] | (h[EI_NIDENT + 3] << 8);
+        ret = machine == ELF_MACHINE;
+    }
+    close(fd);
+    return ret;
+}
+
+static int exec_under_qemu(const char *exe, char **argp, char **envp)
+{
+    static char qemu[PATH_MAX];
+    char **v;
+    int argc = 0, i, ret;
+    ssize_t n;
+
+    n = readlink("/proc/self/exe", qemu, sizeof(qemu) - 1);
+    if (n <= 0) {
+        return safe_execve(exe, argp, envp);
+    }
+    qemu[n] = 0;
+    while (argp[argc]) {
+        argc++;
+    }
+    v = g_new0(char *, argc + 5);
+    v[0] = qemu;
+    v[1] = (char *)"-0";
+    v[2] = argc ? argp[0] : (char *)exe;
+    v[3] = (char *)exe;
+    for (i = 1; i < argc; i++) {
+        v[i + 3] = argp[i];
+    }
+    ret = safe_execve(qemu, v, envp);
+    g_free(v);
+    return ret;
+}
